<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net472;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);NEKO_SCHEMA_FIXTURE</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Source/WorldPresentation.cs" Link="WorldPresentation.cs" />
    <Compile Include="../../Source/WorldResultPaging.cs" Link="WorldResultPaging.cs" />
    <Compile Include="../../Source/SpatialRouteSummary.cs" Link="SpatialRouteSummary.cs" />
    <Compile Include="../../Source/SpatialContract.cs" Link="SpatialContract.cs" />
    <Compile Include="../../Source/WorldObservationContract.cs" Link="WorldObservationContract.cs" />
    <Compile Include="../../Source/KnowledgeSnapshot.cs;../../Source/KnowledgeFields.cs;../../Source/KnowledgeStreamingPublisher.cs" Link="%(Filename)%(Extension)" />
    <None Include="../fixtures/native-enums.json" Link="native-enums.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../Source/NativeEnumScalar.cs;../../Source/SelectionInput.cs;../../Source/PublicFields.cs;../../Source/PublicQuery.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../Source/ResultEvidence.cs" Link="ResultEvidence.cs" />
    <Compile Include="../../Source/SelectionConditions.cs" Link="SelectionConditions.cs" />
    <Compile Include="..\..\Source\ResourceReports.cs" Link="ResourceReports.cs" />
    <Compile Include="..\..\Source\ThingSchema.cs" Link="ThingSchema.cs" />
    <Compile Include="..\..\Source\PawnSchema.cs" Link="PawnSchema.cs" />
    <Compile Include="..\..\Source\QueryArguments.cs" Link="QueryArguments.cs" />
    <Compile Include="..\..\Source\QueryExecution.cs" Link="QueryExecution.cs" />
    <Compile Include="..\..\Source\GameData.cs" Link="GameData.cs" />
    <Compile Include="..\..\Source\GameQueryEngine.cs" Link="GameQueryEngine.cs" />
    <Compile Include="..\..\Source\TemplateCatalog.cs" Link="TemplateCatalog.cs" />

    <PackageReference Include="GraphQL.NewtonsoftJson" Version="8.8.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="..\..\Source\Protocol.cs" Link="Protocol.cs" />
    <Compile Include="..\..\Source\BridgeRuntime.cs" Link="BridgeRuntime.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472"
                      Version="1.0.3"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
